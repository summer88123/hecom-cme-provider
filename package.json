{
  "name": "hecom-cme-provider",
  "displayName": "Hecom CME Provider",
  "description": "为 Hecom Commit Message Editor 提供基于内部业务场景的 provider",
  "version": "0.1.0",
  "publisher": "hecom",
  "repository": {
    "type": "git",
    "url": "https://github.com/hecom/hecom-cme-provider.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "icon.png",
  "contributes": {
    "configuration": {
      "title": "Hecom CME Provider",
      "properties": {
        "hecomCmeProvider.huaweiCloud.credentialsFile": {
          "type": "string",
          "default": "",
          "description": "华为云凭证配置文件路径。文件必须是 JSON 格式，包含 ak 和 sk 字段。如果设置此项，将优先使用文件中的凭证，accessKey 和 secretKey 配置将被忽略。"
        },
        "hecomCmeProvider.huaweiCloud.accessKey": {
          "type": "string",
          "default": "",
          "description": "华为云 AccessKey (AK)，如果设置了 credentialsFile 将被忽略"
        },
        "hecomCmeProvider.huaweiCloud.secretKey": {
          "type": "string",
          "default": "",
          "description": "华为云 SecretKey (SK)，如果设置了 credentialsFile 将被忽略"
        },
        "hecomCmeProvider.huaweiCloud.domainId": {
          "type": "string",
          "default": "",
          "description": "华为云 Domain ID（用于认证，与 AK/SK 配合使用）"
        },
        "hecomCmeProvider.huaweiCloud.projectId": {
          "type": "string",
          "default": "",
          "description": "华为云 CodeArts 项目 ID（用于查询 Issue 数据）"
        },
        "hecomCmeProvider.huaweiCloud.region": {
          "type": "string",
          "default": "cn-north-4",
          "description": "华为云区域"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run lint",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "package": "vsce package",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@jest/globals": "^29.5.0",
    "@types/glob": "^8.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "glob": "^8.0.3",
    "husky": "^8.0.3",
    "jest": "^29.5.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.0",
    "typescript": "^4.9.3"
  },
  "dependencies": {
    "@huaweicloud/huaweicloud-sdk-projectman": "^3.1.0",
    "uuid": "^13.0.0"
  }
}
