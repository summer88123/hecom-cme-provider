{
  "name": "hecom-cme-provider",
  "displayName": "Hecom CME Provider",
  "description": "为 Commit Message Editor 提供基于内部业务场景的 provider",
  "version": "0.0.1",
  "publisher": "hecom",
  "repository": {
    "type": "git",
    "url": "https://github.com/hecom/hecom-cme-provider.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "icon.png",
  "contributes": {
    "configuration": {
      "title": "Hecom CME Provider",
      "properties": {
        "hecomCmeProvider.huaweiCloud.accessKey": {
          "type": "string",
          "default": "",
          "description": "华为云 AccessKey (AK)"
        },
        "hecomCmeProvider.huaweiCloud.secretKey": {
          "type": "string",
          "default": "",
          "description": "华为云 SecretKey (SK)"
        },
        "hecomCmeProvider.huaweiCloud.domainId": {
          "type": "string",
          "default": "",
          "description": "华为云 Domain ID（用于认证，与 AK/SK 配合使用）"
        },
        "hecomCmeProvider.huaweiCloud.projectId": {
          "type": "string",
          "default": "",
          "description": "华为云 CodeArts 项目 ID（用于查询 Issue 数据）"
        },
        "hecomCmeProvider.huaweiCloud.region": {
          "type": "string",
          "default": "cn-north-4",
          "description": "华为云区域"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-electron": "^2.2.0",
    "eslint": "^8.28.0",
    "glob": "^8.0.3",
    "mocha": "^10.1.0",
    "typescript": "^4.9.3"
  },
  "dependencies": {
    "@huaweicloud/huaweicloud-sdk-projectman": "^3.1.0",
    "uuid": "^13.0.0"
  }
}
